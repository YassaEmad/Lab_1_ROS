<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtle_bringup</name>
  <version>1.0.0</version>
  <description>Launch files and parameter config for the Lab 1 turtlesim system.</description>
  <maintainer email="your_email@example.com">Yassa Emad</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2action</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>turtle_control</exec_depend>
  <exec_depend>turtle_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
